# Production settings: every key, no values. On the server, make .env from this file with
#   python3 scripts/make-prod-secrets.py
# which fills the secrets (fresh, never the development ones) and leaves the rest for you to set.
# Never commit .env; never paste its values anywhere.

# --- the address -----------------------------------------------------------------------------------
# the domain (DNS A record to the server); training.<domain> is the training company
APP_DOMAIN=
# the email Let's Encrypt writes to about the certificate
ACME_EMAIL=
# https://<APP_DOMAIN>: links on delivery receipts and QR codes
PUBLIC_BASE_URL=
# https://<APP_DOMAIN> (JSON list), e.g. ["https://app.example.in"]
CORS_ORIGINS=
# where users switch between the real app and the training company
MAIN_URL=
TRAINING_URL=
# map tiles host for the field maps (the browser loads tiles from it)
TILE_HOST=
TZ=

# --- the database (made by make-prod-secrets.py) -------------------------------------------------
POSTGRES_DB=
POSTGRES_USER=
POSTGRES_PASSWORD=

# --- secrets (made by make-prod-secrets.py: fresh, never the development ones) ---------------------
# signs the login tokens
JWT_SECRET=
# encrypts the nightly backup archives (keep a copy off the server: without it no backup opens)
BACKUP_KEY=
# encrypts two-step login secrets in the database
DATA_KEY=
# the demo users' password in the training company only (never in the real one)
DEMO_USER_PASSWORD=

# --- backups -------------------------------------------------------------------------------------------
# the hour (server time) of the nightly backup
BACKUP_HOUR=
BACKUP_KEEP_DAILY=
BACKUP_KEEP_WEEKLY=
BACKUP_KEEP_MONTHLY=
# off-site copy: an rclone remote and path, e.g. offsite:eespl-backups (off while empty)
BACKUP_REMOTE=
# the remote's settings (S3-compatible bucket shown; any rclone backend works)
RCLONE_CONFIG_OFFSITE_TYPE=
RCLONE_CONFIG_OFFSITE_PROVIDER=
RCLONE_CONFIG_OFFSITE_ENDPOINT=
RCLONE_CONFIG_OFFSITE_REGION=
RCLONE_CONFIG_OFFSITE_ACCESS_KEY_ID=
RCLONE_CONFIG_OFFSITE_SECRET_ACCESS_KEY=

# --- email to our own staff only (never clients); off until the director decides -------------------
EMAIL_ENABLED=
SMTP_HOST=
SMTP_PORT=
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM=

# --- Kylas CRM (stays on the sandbox until confirmed) ------------------------------------------------
KYLAS_ENABLED=
KYLAS_BASE_URL=
KYLAS_API_KEY=

# --- the first user ---------------------------------------------------------------------------------
# the director's login, made by python -m app.cli create-director
DIRECTOR_EMAIL=
DIRECTOR_NAME=

# --- optional ----------------------------------------------------------------------------------------
ANTHROPIC_API_KEY=
