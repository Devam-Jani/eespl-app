# Copy to .env and set a real password: cp .env.example .env
POSTGRES_DB=eespl
POSTGRES_USER=eespl
POSTGRES_PASSWORD=change-me

# Used when running the backend on the host (db published on port 5434).
# Inside docker compose the api service overrides this to point at db:5432.
DATABASE_URL=postgresql+psycopg://eespl:change-me@localhost:5434/eespl

CORS_ORIGINS=["http://localhost:5174"]
