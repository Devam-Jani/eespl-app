# Copy to .env and set a real password: cp .env.example .env
POSTGRES_DB=eespl
POSTGRES_USER=eespl
POSTGRES_PASSWORD=change-me

# Used when running the backend on the host (db published on port 5434).
# Inside docker compose the api service overrides this to point at db:5432.
DATABASE_URL=postgresql+psycopg://eespl:change-me@localhost:5434/eespl

CORS_ORIGINS=["http://localhost:5174"]

# Secret for signing access tokens (at least 32 chars). Generate one with:
#   python -c "import secrets; print(secrets.token_urlsafe(48))"
JWT_SECRET=change-me-to-a-random-string-of-at-least-32-characters
# Set to true when the app is served over HTTPS.
COOKIE_SECURE=false

# Kylas CRM (leads pushed out, outcomes polled back). Leave KYLAS_ENABLED=false until the
# "EESPL App" source id is set in Settings > Integrations > Kylas. Paste the key in .env only.
KYLAS_ENABLED=false
KYLAS_BASE_URL=https://api.kylas.io/v1
KYLAS_API_KEY=

# demo users (one per role, invented, marked demo): python -m app.cli seed-demo-team
DEMO_USER_PASSWORD=change-me-demo-password

# the director: their user is made by python -m app.cli create-director
DIRECTOR_EMAIL=
DIRECTOR_NAME=

# email to our own staff only. While EMAIL_ENABLED=false every email goes to the local Mailpit
# (http://127.0.0.1:8026). At go-live: EMAIL_ENABLED=true and the SMTP settings (Microsoft 365:
# turn on SMTP AUTH for the sending mailbox). Never logged or shown.
EMAIL_ENABLED=false
SMTP_HOST=
SMTP_PORT=
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM=

# --- the in-app helper -------------------------------------------------------------------------------
# "Ask the helper" (Claude explains an error and the next step; it never changes data). Off until set
# to true; it needs the Claude API key here (never in the code or the repo).
ANTHROPIC_API_KEY=
HELPER_AI_ENABLED=
# the nightly crawler on the training company reports what it finds with this token (any long random value)
CRAWLER_TOKEN=
