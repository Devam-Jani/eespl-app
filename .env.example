# Copy to .env and set a real password: cp .env.example .env
POSTGRES_DB=eespl
POSTGRES_USER=eespl
POSTGRES_PASSWORD=change-me

# Used when running the backend on the host (db published on port 5434).
# Inside docker compose the api service overrides this to point at db:5432.
DATABASE_URL=postgresql+psycopg://eespl:change-me@localhost:5434/eespl

CORS_ORIGINS=["http://localhost:5174"]

# Secret for signing access tokens (at least 32 chars). Generate one with:
#   python -c "import secrets; print(secrets.token_urlsafe(48))"
JWT_SECRET=change-me-to-a-random-string-of-at-least-32-characters
# Set to true when the app is served over HTTPS.
COOKIE_SECURE=false
